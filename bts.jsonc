{
  "$schema": "https://r2.better-t-stack.dev/schema.json",
  "version": "3.33.2",
  "createdAt": "2026-06-21T15:57:52.124Z",
  "reproducibleCommand": "pnpm create better-t-stack@latest caulk.lol --frontend tanstack-start --backend hono --runtime workers --database sqlite --orm drizzle --api trpc --auth better-auth --payments none --addons evlog oxlint turborepo --examples todo --db-setup d1 --web-deploy cloudflare --server-deploy cloudflare --git --package-manager pnpm --install",
  "database": "sqlite",
  "orm": "drizzle",
  "backend": "hono",
  "runtime": "workers",
  "frontend": ["tanstack-start"],
  "addons": ["evlog", "oxlint", "turborepo"],
  "examples": ["todo"],
  "auth": "better-auth",
  "payments": "none",
  "packageManager": "pnpm",
  "dbSetup": "d1",
  "api": "trpc",
  "webDeploy": "cloudflare",
  "serverDeploy": "cloudflare",
  "workspaceOverrides": ["apps/web renamed to apps/blog", "apps/admin added", "workers/* added"]
