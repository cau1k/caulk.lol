{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".output/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "deploy": {
      "cache": false,
      "passThroughEnv": [
        "STAGE",
        "CI",
        "CLOUDFLARE_EMAIL",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_ZONE_ID",
        "ALCHEMY_PASSWORD",
        "ALCHEMY_STATE_TOKEN",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CORS_ORIGIN",
        "ADMIN_BOOTSTRAP_TOKEN",
        "OWNER_EMAIL",
        "ANALYTICS_ACCOUNT_ID",
        "ANALYTICS_API_TOKEN"
      ]
    },
    "destroy": {
      "cache": false,
      "passThroughEnv": [
        "STAGE",
        "CI",
        "CLOUDFLARE_EMAIL",
        "CLOUDFLARE_API_TOKEN",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_ZONE_ID",
        "ALCHEMY_PASSWORD",
        "ALCHEMY_STATE_TOKEN",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CORS_ORIGIN",
        "ADMIN_BOOTSTRAP_TOKEN",
        "OWNER_EMAIL",
        "ANALYTICS_ACCOUNT_ID",
        "ANALYTICS_API_TOKEN"
      ]
    }
  }
}
